<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>X$ | Acceso al Panel</title>
  <link rel="stylesheet" href="/css/style.css"/>
</head>
<body class="login-page">

  <!-- Fondo animado -->
  <div class="login-bg">
    <img src="/assets/banner.gif" alt="" class="login-bg-gif"/>
    <div class="login-bg-overlay"></div>
  </div>

  <div class="login-container">

    <!-- Logo circular -->
    <div class="login-logo-wrap">
      <div class="login-logo-ring"></div>
      <img src="/assets/logo.gif" alt="X$" class="login-logo-img"/>
    </div>

    <!-- Card -->
    <div class="login-card">
      <div class="login-brand">
        <div class="login-brand-name">⚡ X$ PANEL</div>
        <div class="login-brand-sub">Control Center</div>
      </div>

      <% if (error) { %>
        <div class="alert-error">⚠️ <%= error %></div>
      <% } %>

      <form method="POST" action="/login" autocomplete="off">
        <div class="form-group">
          <label class="form-label">👤 Usuario</label>
          <input type="text" name="username" class="form-input" placeholder="Usuario" required/>
        </div>
        <div class="form-group">
          <label class="form-label">🔒 Contraseña</label>
          <input type="password" name="password" class="form-input" placeholder="••••••••" required/>
        </div>
        <button type="submit" class="btn-primary">ACCEDER →</button>
      </form>

      <p class="login-footer-text">
        <span>X$</span> · Lo mejor en venta de cheats 🔥
      </p>
    </div>

  </div>
</body>
</html>
