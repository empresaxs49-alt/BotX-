<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#020704">
  <title>X$ Panel · Acceso</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="login-page">
  <div class="ambient-background" aria-hidden="true">
    <img src="/assets/banner.gif" class="ambient-banner" alt="">
    <div class="ambient-shade"></div>
    <div class="ambient-grid"></div>
  </div>

  <main class="login-shell">
    <div class="login-orbit" aria-hidden="true"></div>
    <div class="brand-lockup">
      <span class="brand-logo brand-logo--large"><img src="/assets/logo.gif" alt="Logo X$"></span>
      <div>
        <p class="brand-kicker">CONTROL CENTER</p>
        <h1>X$ <span>Panel</span></h1>
      </div>
    </div>

    <section class="login-card" aria-labelledby="login-title">
      <div class="login-card__header">
        <span class="eyebrow">ACCESO SEGURO</span>
        <h2 id="login-title">Bienvenido de nuevo</h2>
        <p>Inicia sesión para administrar el bot, los tickets y la comunidad.</p>
      </div>

      <% if (error) { %>
        <div class="notice notice--error" role="alert">⚠ <%= error %></div>
      <% } %>

      <form method="post" action="/login" class="stack-form" autocomplete="on">
        <label class="field">
          <span>Usuario</span>
          <input name="username" type="text" autocomplete="username" placeholder="Tu usuario" required maxlength="64" autofocus>
        </label>
        <label class="field">
          <span>Contraseña</span>
          <input name="password" type="password" autocomplete="current-password" placeholder="••••••••" required maxlength="128">
        </label>
        <button class="button button--primary button--full" type="submit">Entrar al panel <span aria-hidden="true">→</span></button>
      </form>

      <p class="login-card__foot"><span class="presence-dot"></span> Panel protegido · Sesión de 6 horas</p>
    </section>
  </main>
</body>
</html>
